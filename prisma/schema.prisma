generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TALENT
  EMPLOYER
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  COMPLETED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER_SENT
  OFFER_ACCEPTED
  OFFER_REJECTED
  REJECTED
  WITHDRAWN
}

enum ResumeStatus {
  PROCESSING
  READY
  FAILED
}

enum NotificationType {
  NEW_APPLICATION
  APPLICATION_UPDATE
  SYSTEM_ALERT
  MESSAGE
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique @db.VarChar(255)
  passwordHash     String           @map("password_hash") @db.VarChar(255)
  role             UserRole
  isEmailVerified         Boolean          @default(false) @map("is_email_verified")
  emailVerificationToken  String?          @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpires DateTime?        @map("email_verification_expires")
  passwordResetToken      String?          @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires    DateTime?        @map("password_reset_expires")
  isActive                Boolean          @default(true) @map("is_active")
  refreshTokenHash String?          @map("refresh_token_hash") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  talentProfile    TalentProfile?
  employerProfile  EmployerProfile?
  adminProfile     AdminProfile?
  notifications    Notification[]
  contactMessages  ContactMessage[]
  contactReplies   ContactReply[]

  @@map("users")
}

model TalentProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  fullName              String   @map("full_name") @db.VarChar(255)
  workEmail             String   @map("work_email") @db.VarChar(255)
  location              Json?
  phone                 String?  @db.VarChar(50)
  educations            Json     @default("[]")
  skills                String[] @default([])
  experiences           Json     @default("[]")
  resumeUrl             String?  @map("resume_url") @db.Text
  avatarUrl             String?  @map("avatar_url") @db.Text

  dob                   String?  @db.VarChar(50)
  age                   String?  @db.VarChar(20)
  gender                String?  @db.VarChar(50)
  nationality           String?  @db.VarChar(100)
  countryOfResidence    String?  @map("country_of_residence") @db.VarChar(100)
  whatsapp              String?  @db.VarChar(50)
  linkedin              String?  @db.VarChar(255)
  opportunityType       String?  @map("opportunity_type") @db.VarChar(100)
  preferredIndustry     String?  @map("preferred_industry") @db.VarChar(100)
  preferredRole         String?  @map("preferred_role") @db.VarChar(100)
  preferredSalary       String?  @map("preferred_salary") @db.VarChar(100)
  startDate             String?  @map("start_date") @db.VarChar(100)
  jobTitle              String?  @map("job_title") @db.VarChar(255)
  employerName          String?  @map("employer_name") @db.VarChar(255)
  employmentCountry     String?  @map("employment_country") @db.VarChar(100)
  totalExp              String?  @map("total_exp") @db.VarChar(50)
  relevantExp           String?  @map("relevant_exp") @db.VarChar(50)
  summary               String?  @db.Text
  isEmployed            String?  @map("is_employed") @db.VarChar(20)
  workedOverseas        String?  @map("worked_overseas") @db.VarChar(20)
  overseasCountries     String?  @map("overseas_countries") @db.Text
  highestQualification  String?  @map("highest_qualification") @db.VarChar(255)
  fieldOfStudy          String?  @map("field_of_study") @db.VarChar(255)
  institutionName       String?  @map("institution_name") @db.VarChar(255)
  graduationYear        String?  @map("graduation_year") @db.VarChar(20)
  hasLicences           String?  @map("has_licences") @db.VarChar(20)
  licencesList          String?  @map("licences_list") @db.Text
  englishTest           String?  @map("english_test") @db.VarChar(100)
  overallScore          String?  @map("overall_score") @db.VarChar(50)
  testDate              String?  @map("test_date") @db.VarChar(50)
  visaStatus            String?  @map("visa_status") @db.VarChar(100)
  legalWorkRights       String?  @map("legal_work_rights") @db.VarChar(100)
  openToRelocation      String?  @map("open_to_relocation") @db.VarChar(20)
  appliedAusVisa        String?  @map("applied_aus_visa") @db.VarChar(20)
  visaTypeApplied       String?  @map("visa_type_applied") @db.VarChar(100)
  visaRefusal           String?  @map("visa_refusal") @db.VarChar(20)
  visaRefusalDetails    String?  @map("visa_refusal_details") @db.Text
  relocateAloneOrFamily String?  @map("relocate_alone_or_family") @db.VarChar(100)
  validPassport         String?  @map("valid_passport") @db.VarChar(20)
  passportExpiry        String?  @map("passport_expiry") @db.VarChar(50)
  medicalBackgroundCheck String? @map("medical_background_check") @db.VarChar(20)
  criminalConvictions   String?  @map("criminal_convictions") @db.VarChar(20)
  criminalDetails       String?  @map("criminal_details") @db.Text
  passportUrl           String?  @map("passport_url") @db.Text
  visaUrl               String?  @map("visa_url") @db.Text
  eduCertUrl            String?  @map("edu_cert_url") @db.Text
  empCertUrl            String?  @map("emp_cert_url") @db.Text
  englishTestUrl        String?  @map("english_test_url") @db.Text
  licenceUrl            String?  @map("licence_url") @db.Text
  declarationTrue       String?  @map("declaration_true") @db.VarChar(20)
  declarationConsent    String?  @map("declaration_consent") @db.VarChar(20)

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes               Resume[]
  applications          Application[]

  @@map("talent_profiles")
}

model Resume {
  id               String        @id @default(uuid()) @db.Uuid
  talentId         String        @map("talent_id") @db.Uuid
  fileName         String        @map("file_name") @db.VarChar(255)
  fileUrl          String        @map("file_url") @db.Text
  fileSize         Int?          @map("file_size")
  mimeType         String?       @map("mime_type") @db.VarChar(100)
  isDefault        Boolean       @default(false) @map("is_default")
  status           ResumeStatus  @default(PROCESSING)
  
  parsedName       String?       @map("parsed_name") @db.VarChar(255)
  parsedEmail      String?       @map("parsed_email") @db.VarChar(255)
  parsedPhone      String?       @map("parsed_phone") @db.VarChar(50)
  parsedSkills     Json          @default("[]") @map("parsed_skills")
  parsedExperience Int?          @map("parsed_experience")
  parsedEducation  String?       @map("parsed_education") @db.VarChar(255)
  parsedSummary    String?       @map("parsed_summary") @db.Text
  rawText          String?       @map("raw_text") @db.Text
  atsBaseScore     Float?        @map("ats_base_score")
  
  uploadedAt       DateTime      @default(now()) @map("uploaded_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  
  talent           TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  applications     Application[]

  @@map("resumes")
}

model EmployerProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  firstName       String   @map("first_name") @db.VarChar(100)
  lastName        String   @map("last_name") @db.VarChar(100)
  businessPhone   String?  @map("business_phone") @db.VarChar(50)
  businessEmail   String   @map("business_email") @db.VarChar(255)
  companyName     String   @map("company_name") @db.VarChar(255)
  jobTitle        String?  @map("job_title") @db.VarChar(255)
  jobTitleToHire  String?  @map("job_title_to_hire") @db.VarChar(255)
  zipCode         String?  @map("zip_code") @db.VarChar(20)
  positionType    String?  @map("position_type") @db.VarChar(100)
  companyLogo     String?  @map("company_logo") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employer_profiles")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(255)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @default("GENERAL_QUERY") @db.VarChar(50)
  status    String   @default("PENDING") @db.VarChar(50)
  notes     String?  @db.Text
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   ContactReply[]

  @@map("contact_messages")
}

model Job {
  id                  String   @id @default(uuid()) @db.Uuid
  title               String   @db.VarChar(255)
  company             String   @db.VarChar(255)
  industry            String?  @db.VarChar(100)
  category            String   @db.VarChar(100)
  location            String   @db.VarChar(255)
  mode                String   @db.VarChar(50)
  type                String   @db.VarChar(50)
  salary              String?  @db.VarChar(100)
  salaryMin           Int?     @map("salary_min")
  salaryMax           Int?     @map("salary_max")
  salaryCurrency      String?  @default("USD") @map("salary_currency") @db.VarChar(10)
  vacancies           Int      @default(1)
  description         String   @db.Text
  requirements        Json     @default("[]")
  benefits            Json     @default("[]")
  skills              Json     @default("[]")
  experienceMin       Int?     @map("experience_min")
  experienceMax       Int?     @map("experience_max")
  educationLevel      String?  @map("education_level") @db.VarChar(100)
  status              JobStatus @default(DRAFT)
  isPublished         Boolean  @default(false) @map("is_published")
  companyLogo         String?  @map("company_logo") @db.Text
  applicationDeadline DateTime? @map("application_deadline")
  publishedAt         DateTime? @map("published_at")
  closedAt            DateTime? @map("closed_at")
  postedAt            DateTime @default(now()) @map("posted_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  applications        Application[]

  @@map("jobs")
}

model AdminProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  firstName    String   @default("Orange") @map("first_name") @db.VarChar(100)
  lastName     String   @default("Global") @map("last_name") @db.VarChar(100)
  phone        String?  @default("+09 363 398 46") @db.VarChar(50)
  bio          String?  @default("Super Administrator") @db.Text
  avatarUrl    String?  @map("avatar_url") @db.Text
  facebook     String?  @default("https://facebook.com/orangeglobal") @db.VarChar(255)
  twitter      String?  @default("https://twitter.com/orangeglobal") @map("twitter") @db.VarChar(255)
  linkedin     String?  @default("https://linkedin.com/company/orange-global") @db.VarChar(255)
  instagram    String?  @default("https://instagram.com/orangeglobal") @db.VarChar(255)
  country      String?  @default("Australia") @db.VarChar(100)
  cityState    String?  @default("Melbourne, Victoria") @map("city_state") @db.VarChar(255)
  postalCode   String?  @default("3000") @map("postal_code") @db.VarChar(50)
  taxId        String?  @default("TAX987654") @map("tax_id") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model Application {
  id                  String            @id @default(uuid()) @db.Uuid
  jobId               String            @map("job_id") @db.Uuid
  talentId            String            @map("talent_id") @db.Uuid
  resumeId            String            @map("resume_id") @db.Uuid
  coverLetter         String?           @map("cover_letter") @db.Text
  status              ApplicationStatus @default(APPLIED)
  
  atsScore            Float?            @map("ats_score")
  atsSkillMatch       Float?            @map("ats_skill_match")
  atsExperienceMatch  Float?            @map("ats_experience_match")
  atsEducationMatch   Float?            @map("ats_education_match")
  atsKeywordMatch     Float?            @map("ats_keyword_match")
  atsBreakdown        Json?             @map("ats_breakdown")
  
  adminNotes          String?           @map("admin_notes") @db.Text
  reviewedAt          DateTime?         @map("reviewed_at")
  reviewedBy          String?           @map("reviewed_by") @db.VarChar(255)
  
  interviewDate       DateTime?         @map("interview_date")
  interviewType       String?           @map("interview_type") @db.VarChar(50)
  interviewLink       String?           @map("interview_link") @db.Text
  interviewNotes      String?           @map("interview_notes") @db.Text
  
  offerSentAt         DateTime?         @map("offer_sent_at")
  offerDetails        Json?             @map("offer_details")
  
  appliedAt           DateTime          @default(now()) @map("applied_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  talent              TalentProfile     @relation(fields: [talentId], references: [id], onDelete: Cascade)
  resume              Resume            @relation(fields: [resumeId], references: [id])
  statusHistory       ApplicationStatusHistory[]

  @@unique([jobId, talentId])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  changedBy     String            @map("changed_by") @db.VarChar(255)
  note          String?           @db.Text
  changedAt     DateTime          @default(now()) @map("changed_at")

  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_history")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @db.VarChar(255)
  message   String           @db.Text
  type      NotificationType @default(SYSTEM_ALERT)
  isRead    Boolean          @default(false) @map("is_read")
  link      String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ContactReply {
  id               String         @id @default(uuid()) @db.Uuid
  contactMessageId String         @map("contact_message_id") @db.Uuid
  senderId         String         @map("sender_id") @db.Uuid
  senderRole       UserRole       @map("sender_role")
  message          String         @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")

  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  sender           User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("contact_replies")
}
