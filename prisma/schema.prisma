generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TALENT
  EMPLOYER
  ADMIN
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique @db.VarChar(255)
  passwordHash     String           @map("password_hash") @db.VarChar(255)
  role             UserRole
  isEmailVerified         Boolean          @default(false) @map("is_email_verified")
  emailVerificationToken  String?          @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpires DateTime?        @map("email_verification_expires")
  passwordResetToken      String?          @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires    DateTime?        @map("password_reset_expires")
  isActive                Boolean          @default(true) @map("is_active")
  refreshTokenHash String?          @map("refresh_token_hash") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  talentProfile    TalentProfile?
  employerProfile  EmployerProfile?
  adminProfile     AdminProfile?

  @@map("users")
}

model TalentProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  fullName              String   @map("full_name") @db.VarChar(255)
  workEmail             String   @map("work_email") @db.VarChar(255)
  location              Json?
  phone                 String?  @db.VarChar(50)
  educations            Json     @default("[]")
  skills                String[] @default([])
  experiences           Json     @default("[]")
  resumeUrl             String?  @map("resume_url") @db.Text
  avatarUrl             String?  @map("avatar_url") @db.Text

  dob                   String?  @db.VarChar(50)
  age                   String?  @db.VarChar(20)
  gender                String?  @db.VarChar(50)
  nationality           String?  @db.VarChar(100)
  countryOfResidence    String?  @map("country_of_residence") @db.VarChar(100)
  whatsapp              String?  @db.VarChar(50)
  linkedin              String?  @db.VarChar(255)
  opportunityType       String?  @map("opportunity_type") @db.VarChar(100)
  preferredIndustry     String?  @map("preferred_industry") @db.VarChar(100)
  preferredRole         String?  @map("preferred_role") @db.VarChar(100)
  preferredSalary       String?  @map("preferred_salary") @db.VarChar(100)
  startDate             String?  @map("start_date") @db.VarChar(100)
  jobTitle              String?  @map("job_title") @db.VarChar(255)
  employerName          String?  @map("employer_name") @db.VarChar(255)
  employmentCountry     String?  @map("employment_country") @db.VarChar(100)
  totalExp              String?  @map("total_exp") @db.VarChar(50)
  relevantExp           String?  @map("relevant_exp") @db.VarChar(50)
  summary               String?  @db.Text
  isEmployed            String?  @map("is_employed") @db.VarChar(20)
  workedOverseas        String?  @map("worked_overseas") @db.VarChar(20)
  overseasCountries     String?  @map("overseas_countries") @db.Text
  highestQualification  String?  @map("highest_qualification") @db.VarChar(255)
  fieldOfStudy          String?  @map("field_of_study") @db.VarChar(255)
  institutionName       String?  @map("institution_name") @db.VarChar(255)
  graduationYear        String?  @map("graduation_year") @db.VarChar(20)
  hasLicences           String?  @map("has_licences") @db.VarChar(20)
  licencesList          String?  @map("licences_list") @db.Text
  englishTest           String?  @map("english_test") @db.VarChar(100)
  overallScore          String?  @map("overall_score") @db.VarChar(50)
  testDate              String?  @map("test_date") @db.VarChar(50)
  visaStatus            String?  @map("visa_status") @db.VarChar(100)
  legalWorkRights       String?  @map("legal_work_rights") @db.VarChar(100)
  openToRelocation      String?  @map("open_to_relocation") @db.VarChar(20)
  appliedAusVisa        String?  @map("applied_aus_visa") @db.VarChar(20)
  visaTypeApplied       String?  @map("visa_type_applied") @db.VarChar(100)
  visaRefusal           String?  @map("visa_refusal") @db.VarChar(20)
  visaRefusalDetails    String?  @map("visa_refusal_details") @db.Text
  relocateAloneOrFamily String?  @map("relocate_alone_or_family") @db.VarChar(100)
  validPassport         String?  @map("valid_passport") @db.VarChar(20)
  passportExpiry        String?  @map("passport_expiry") @db.VarChar(50)
  medicalBackgroundCheck String? @map("medical_background_check") @db.VarChar(20)
  criminalConvictions   String?  @map("criminal_convictions") @db.VarChar(20)
  criminalDetails       String?  @map("criminal_details") @db.Text
  passportUrl           String?  @map("passport_url") @db.Text
  visaUrl               String?  @map("visa_url") @db.Text
  eduCertUrl            String?  @map("edu_cert_url") @db.Text
  empCertUrl            String?  @map("emp_cert_url") @db.Text
  englishTestUrl        String?  @map("english_test_url") @db.Text
  licenceUrl            String?  @map("licence_url") @db.Text
  declarationTrue       String?  @map("declaration_true") @db.VarChar(20)
  declarationConsent    String?  @map("declaration_consent") @db.VarChar(20)

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes               Resume[]

  @@map("talent_profiles")
}

model Resume {
  id           String        @id @default(uuid()) @db.Uuid
  talentId     String        @map("talent_id") @db.Uuid
  fileName     String        @map("file_name") @db.VarChar(255)
  fileUrl      String        @map("file_url") @db.Text
  isDefault    Boolean       @default(false) @map("is_default")
  atsScore     Int?          @map("ats_score")
  parsedSkills String[]      @default([]) @map("parsed_skills")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  talent       TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model EmployerProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  firstName       String   @map("first_name") @db.VarChar(100)
  lastName        String   @map("last_name") @db.VarChar(100)
  businessPhone   String?  @map("business_phone") @db.VarChar(50)
  businessEmail   String   @map("business_email") @db.VarChar(255)
  companyName     String   @map("company_name") @db.VarChar(255)
  jobTitle        String?  @map("job_title") @db.VarChar(255)
  jobTitleToHire  String?  @map("job_title_to_hire") @db.VarChar(255)
  zipCode         String?  @map("zip_code") @db.VarChar(20)
  positionType    String?  @map("position_type") @db.VarChar(100)
  companyLogo     String?  @map("company_logo") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employer_profiles")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(255)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model Job {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(255)
  company      String   @db.VarChar(255)
  industry     String?  @db.VarChar(100)
  category     String   @db.VarChar(100)
  location     String   @db.VarChar(255)
  mode         String   @db.VarChar(50)
  type         String   @db.VarChar(50)
  salary       String?  @db.VarChar(100)
  vacancies    Int      @default(1)
  description  String   @db.Text
  requirements Json     @default("[]")
  benefits     Json     @default("[]")
  isPublished  Boolean  @default(true)  @map("is_published")
  postedAt     DateTime @default(now()) @map("posted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  @@map("jobs")
}

model AdminProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  firstName    String   @default("Orange") @map("first_name") @db.VarChar(100)
  lastName     String   @default("Global") @map("last_name") @db.VarChar(100)
  phone        String?  @default("+09 363 398 46") @db.VarChar(50)
  bio          String?  @default("Super Administrator") @db.Text
  avatarUrl    String?  @map("avatar_url") @db.Text
  facebook     String?  @default("https://facebook.com/orangeglobal") @db.VarChar(255)
  twitter      String?  @default("https://twitter.com/orangeglobal") @map("twitter") @db.VarChar(255)
  linkedin     String?  @default("https://linkedin.com/company/orange-global") @db.VarChar(255)
  instagram    String?  @default("https://instagram.com/orangeglobal") @db.VarChar(255)
  country      String?  @default("Australia") @db.VarChar(100)
  cityState    String?  @default("Melbourne, Victoria") @map("city_state") @db.VarChar(255)
  postalCode   String?  @default("3000") @map("postal_code") @db.VarChar(50)
  taxId        String?  @default("TAX987654") @map("tax_id") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

